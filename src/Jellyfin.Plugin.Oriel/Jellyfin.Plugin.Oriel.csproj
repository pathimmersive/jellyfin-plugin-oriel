<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Oriel</RootNamespace>
    <Version>0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The plugin ABI the build declares; Jellyfin refuses to load a plugin whose targetAbi is newer than the server. -->
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides these at runtime; ExcludeAssets keeps them out of the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <!-- SQLite for the plugin's own store, at the versions the Jellyfin 12.2 server ships and loads. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" ExcludeAssets="runtime" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.12" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The reader web app in ../reader is built with npm and its dist/ output embedded. -->
  <PropertyGroup>
    <ReaderDir>$(MSBuildThisFileDirectory)..\reader\</ReaderDir>
  </PropertyGroup>

  <ItemGroup>
    <ReaderSource Include="$(ReaderDir)src\**;$(ReaderDir)vendor\**;$(ReaderDir)index.html;$(ReaderDir)data.html;$(ReaderDir)vite.config.ts;$(ReaderDir)tsconfig.json;$(ReaderDir)package-lock.json" />
  </ItemGroup>

  <Target Name="RestoreReader" Inputs="$(ReaderDir)package.json;$(ReaderDir)package-lock.json" Outputs="$(ReaderDir)node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ReaderDir)" />
  </Target>

  <Target Name="BuildReader" DependsOnTargets="RestoreReader" BeforeTargets="BeforeBuild" Inputs="@(ReaderSource)" Outputs="$(ReaderDir)dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(ReaderDir)" />
  </Target>

  <Target Name="EmbedReader" AfterTargets="BuildReader" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_ReaderDist Include="$(ReaderDir)dist\**" />
      <EmbeddedResource Include="@(_ReaderDist)" LogicalName="oriel-web/%(_ReaderDist.RecursiveDir)%(_ReaderDist.Filename)%(_ReaderDist.Extension)" />
    </ItemGroup>
    <Error Condition="'@(_ReaderDist)' == ''" Text="The reader build produced no files in $(ReaderDir)dist." />
  </Target>

  <!-- The jellyfin-web launcher is served beside the reader at /Oriel/integration/launcher.js. -->
  <ItemGroup>
    <EmbeddedResource Include="..\integration\launcher.js" LogicalName="oriel-web/integration/launcher.js" />
  </ItemGroup>

  <!-- meta.json is the plugin manifest Jellyfin reads from the plugin folder. -->
  <Target Name="WritePluginMeta" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_PluginMetaPath>$(IntermediateOutputPath)meta.json</_PluginMetaPath>
      <_PluginMetaJson>{
  "category": "General",
  "description": "An e-book reader hosted on the Jellyfin server.",
  "guid": "2c488ea7-0cae-4499-a2a7-6bae27b4e8f6",
  "name": "Oriel",
  "overview": "Read EPUB books from your Jellyfin library.",
  "owner": "oriel",
  "targetAbi": "$(JellyfinTargetAbi)",
  "version": "$(Version)"
}</_PluginMetaJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PluginMetaPath)" Lines="$(_PluginMetaJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_PluginMetaPath)" Link="meta.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(_PluginMetaPath)" />
    </ItemGroup>
  </Target>

</Project>
